# Kling AI API Configuration
# Option 1: API Key only (recommended for new accounts)
KLING_AI_API_KEY=your-kling-api-key

# Option 2: Access Key + Secret Key (for older accounts with JWT auth)
# KLING_AI_SECRET_KEY=your-kling-secret-key

# API Base URL (default: Singapore region)
KLING_AI_BASE_URL=https://api-singapore.klingai.com

# Server Port
SERVER_PORT=8001
